rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      // Only the admin Google account can write. Change the email if you use another.
      allow write: if request.auth != null
                   && request.auth.token.email == "uduaghangideon@gmail.com"
                   && request.auth.token.email_verified == true;
    }
  }
}
